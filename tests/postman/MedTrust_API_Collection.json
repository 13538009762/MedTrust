        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"查询授权列表成功\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08. 突发危急抢救 Break-Glass 紧急访问通道",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"record_id\": 1, \"emergency_reason\": \"COMA\", \"description\": \"患者急性昏迷无意识，急诊手术抢救，依法申请破窗调阅历史过敏史与诊疗记录\", \"doctor_confirmed\": 1}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/access/break-glass",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "access",
            "break-glass"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"破窗请求处理完成\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09. 医疗数据跨端一致性与防篡改验真 (三方动态核验)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/verification/{{record_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "verification",
            "{{record_id}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"验真接口正常响应\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "    if (pm.response.code === 200) {",
              "        var j = pm.response.json();",
              "        pm.expect(j.data).to.have.property(\"is_tampered\");",
              "    }",
              "});"
            ]
          }
        }
      ]
    },

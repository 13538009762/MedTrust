# ==============================================================================
# MedTrust 跨医院医疗数据可信共享系统 2.0 - Docker 环境变量模板
# ==============================================================================

# 运行环境模式: demo (演示容灾模式，默认) 或 production (严格生产模式)
APP_ENV=demo

# CORS 跨域白名单（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL 配置
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=medtrust
MYSQL_PORT=3307

# Redis 配置
REDIS_PORT=6379

# 后端核心与安全网关配置
JWT_SECRET=medtrust_secure_jwt_secret_key_2026
AES_MASTER_KEY=MedTrustMasterKeyAES256GCM2026!
BLOCKCHAIN_MODE=fabric
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051

# AI Agent 配置 (留空自动启用内置医疗知识时空演变推理引擎)
AI_API_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat

# 前端服务对外暴露端口
FRONTEND_PORT=5173
